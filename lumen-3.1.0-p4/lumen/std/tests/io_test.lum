use "../io.lum" as io

test "parse_int positive":
    assert_eq(io.parse_int("42"), 42)
    assert_eq(io.parse_int("0"), 0)

test "parse_int negative":
    assert_eq(io.parse_int("-42"), -42)

test "parse_int invalid input fails":
    try:
        io.parse_int("abc")
        fail("should have raised")
    catch e:
        assert(true)

test "parse_float whole number":
    assert_eq(io.parse_float("5"), 5.0)

test "parse_float with fraction":
    let v = io.parse_float("3.14")
    assert(v - 3.14 < 0.00001)
    assert(v - 3.14 > -0.00001)

test "parse_float negative with fraction":
    let v = io.parse_float("-3.5")
    assert(v < -3.49)
    assert(v > -3.51)

test "parse_float negative without fraction":
    assert_eq(io.parse_float("-5"), -5.0)

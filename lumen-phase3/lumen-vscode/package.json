{
  "name": "lumen-lang",
  "displayName": "Lumen Language",
  "description": "Syntax highlighting, diagnostics, and autocomplete for Lumen (Language Specification 1.1)",
  "version": "1.1.0",
  "publisher": "krishkumar",
  "author": "Krish Kumar",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:lumen"],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "lumen",
        "aliases": ["Lumen", "lumen"],
        "extensions": [".lum"],
        "configuration": "./language-configuration.json",
        "icon": { "light": "./icon.svg", "dark": "./icon.svg" }
      }
    ],
    "grammars": [
      {
        "language": "lumen",
        "scopeName": "source.lumen",
        "path": "./syntaxes/lumen.tmLanguage.json"
      }
    ]
  }
}

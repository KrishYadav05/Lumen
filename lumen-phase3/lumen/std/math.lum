# std/math.lum — Lumen 1.1 standard library
#
# floor/ceil derive from `%` (no truncation builtin exists); verified:
# x - (x % 1) is floor(x) for positive AND negative floats.
#
# sqrt() uses recursion, not a for-loop with a mutated running variable.
# A first draft used a for-loop and silently did ZERO Newton iterations —
# language.md §1.11 Rule B means reassigning a plain variable inside a
# `for` body only ever affects that iteration's own throwaway scope, never
# the enclosing one. Recursion threads state through arguments instead,
# with no such trap. 24 iterations converges to full double precision.

let PI = 3.14159265358979
let E = 2.71828182845905

fn abs(x):
    if x < 0:
        return 0 - x
    return x

fn min(a, b):
    if a < b:
        return a
    return b

fn max(a, b):
    if a > b:
        return a
    return b

fn floor(x):
    return x - (x % 1)

fn ceil(x):
    return 0 - floor(0 - x)

fn round(x):
    if x >= 0:
        return floor(x + 0.5)
    return 0 - floor(0 - x + 0.5)

fn pow(base, exponent):
    if exponent == 0:
        return 1
    if exponent < 0:
        return 1.0 / pow(base, 0 - exponent)
    return base * pow(base, exponent - 1)

fn sqrt_iter(guess, x, remaining):
    if remaining == 0:
        return guess
    let next_guess = (guess + x / guess) / 2.0
    return sqrt_iter(next_guess, x, remaining - 1)

fn sqrt(x):
    if x < 0:
        fail("sqrt: cannot take the square root of a negative number")
    if x == 0:
        return 0.0
    return sqrt_iter(x / 2.0, x, 24)

fn clamp(x, lo, hi):
    return max(lo, min(hi, x))

fn sign(x):
    if x > 0:
        return 1
    if x < 0:
        return -1
    return 0

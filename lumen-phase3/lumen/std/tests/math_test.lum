use "../math.lum" as math

test "abs":
    assert_eq(math.abs(-5), 5)
    assert_eq(math.abs(5), 5)

test "min and max":
    assert_eq(math.min(3, 7), 3)
    assert_eq(math.max(3, 7), 7)

test "floor":
    assert_eq(math.floor(3.7), 3.0)
    assert_eq(math.floor(-3.7), -4.0)

test "ceil":
    assert_eq(math.ceil(3.2), 4.0)
    assert_eq(math.ceil(-3.2), -3.0)

test "round":
    assert_eq(math.round(3.4), 3.0)
    assert_eq(math.round(3.5), 4.0)
    assert_eq(math.round(-3.5), -4.0)

test "pow":
    assert_eq(math.pow(2, 10), 1024)
    assert_eq(math.pow(2, 0), 1)

test "sqrt":
    let r = math.sqrt(144.0)
    assert(math.abs(r - 12.0) < 0.0001)

test "sqrt of zero":
    assert_eq(math.sqrt(0), 0.0)

test "sqrt of negative fails":
    try:
        math.sqrt(-1)
        fail("should have raised")
    catch e:
        assert(true)

test "clamp":
    assert_eq(math.clamp(15, 0, 10), 10)
    assert_eq(math.clamp(5, 0, 10), 5)

test "sign":
    assert_eq(math.sign(5), 1)
    assert_eq(math.sign(-5), -1)
    assert_eq(math.sign(0), 0)

use "../collections.lum" as col

test "sum":
    assert_eq(col.sum([1, 2, 3, 4, 5]), 15)
    assert_eq(col.sum([]), 0)

test "min_list and max_list":
    assert_eq(col.min_list([5, 3, 8, 1, 9]), 1)
    assert_eq(col.max_list([5, 3, 8, 1, 9]), 9)

test "min_list on empty list fails":
    try:
        col.min_list([])
        fail("should have raised")
    catch e:
        assert(true)

test "reverse":
    assert_eq(col.reverse([1, 2, 3]), [3, 2, 1])
    assert_eq(col.reverse([]), [])

test "contains and index_of":
    assert(col.contains([1, 2, 3], 2))
    assert_eq(col.index_of([1, 2, 3], 3), 2)
    assert_eq(col.index_of([1, 2, 3], 99), -1)

test "unique":
    assert_eq(col.unique([1, 2, 2, 3, 1, 4]), [1, 2, 3, 4])

test "range":
    assert_eq(col.range(5), [0, 1, 2, 3, 4])
    assert_eq(col.range(0), [])

test "range_between":
    assert_eq(col.range_between(3, 7), [3, 4, 5, 6])

test "concat":
    assert_eq(col.concat([1, 2], [3, 4]), [1, 2, 3, 4])

test "flatten":
    assert_eq(col.flatten([[1, 2], [3], [4, 5, 6]]), [1, 2, 3, 4, 5, 6])
    assert_eq(col.flatten([]), [])

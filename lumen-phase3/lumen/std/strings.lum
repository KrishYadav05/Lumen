# std/strings.lum — Lumen 1.1 standard library
#
# Built on `substring` (recursive — no slicing syntax exists). Recursion
# throughout, not for-loop mutation (see std/math.lum). Input over ~900
# chars may hit the interpreter's recursion-depth limit (VM has none).
# `trim` only strips ASCII spaces: Lumen has no string escapes and a
# literal cannot span a source line, so a tab/newline can't be written.

fn substring(s, start, length):
    if length <= 0:
        return ""
    if start >= len(s):
        return ""
    if start < 0:
        return substring(s, 0, length + start)
    return s[start] + substring(s, start + 1, length - 1)

fn starts_with(s, prefix):
    if len(prefix) > len(s):
        return false
    return substring(s, 0, len(prefix)) == prefix

fn ends_with(s, suffix):
    if len(suffix) > len(s):
        return false
    return substring(s, len(s) - len(suffix), len(suffix)) == suffix

fn index_of_from(s, sub, start):
    if start > len(s) - len(sub):
        return -1
    if substring(s, start, len(sub)) == sub:
        return start
    return index_of_from(s, sub, start + 1)

fn index_of(s, sub):
    if len(sub) == 0:
        return 0
    return index_of_from(s, sub, 0)

fn contains(s, sub):
    return index_of(s, sub) >= 0

fn replace(s, old, new):
    if len(old) == 0:
        return s
    let idx = index_of(s, old)
    if idx < 0:
        return s
    let after = substring(s, idx + len(old), len(s) - idx - len(old))
    return substring(s, 0, idx) + new + replace(after, old, new)

fn split(s, sep):
    if len(sep) == 0:
        fail("split: separator must not be empty")
    let idx = index_of(s, sep)
    if idx < 0:
        return [s]
    let head = substring(s, 0, idx)
    let rest = split(substring(s, idx + len(sep), len(s) - idx - len(sep)), sep)
    let result = [head]
    for piece in rest:
        push(result, piece)
    return result

fn join_from(parts, i, sep):
    if i == len(parts) - 1:
        return parts[i]
    return parts[i] + sep + join_from(parts, i + 1, sep)

fn join(parts, sep):
    if len(parts) == 0:
        return ""
    return join_from(parts, 0, sep)

let UPPER_MAP = {"a":"A","b":"B","c":"C","d":"D","e":"E","f":"F","g":"G","h":"H",
                  "i":"I","j":"J","k":"K","l":"L","m":"M","n":"N","o":"O","p":"P",
                  "q":"Q","r":"R","s":"S","t":"T","u":"U","v":"V","w":"W","x":"X",
                  "y":"Y","z":"Z"}
let LOWER_MAP = {"A":"a","B":"b","C":"c","D":"d","E":"e","F":"f","G":"g","H":"h",
                  "I":"i","J":"j","K":"k","L":"l","M":"m","N":"n","O":"o","P":"p",
                  "Q":"q","R":"r","S":"s","T":"t","U":"u","V":"v","W":"w","X":"x",
                  "Y":"y","Z":"z"}

fn upper_char(c):
    try:
        return UPPER_MAP[c]
    catch e:
        return c

fn lower_char(c):
    try:
        return LOWER_MAP[c]
    catch e:
        return c

fn to_upper_from(s, i):
    if i >= len(s):
        return ""
    return upper_char(s[i]) + to_upper_from(s, i + 1)

fn to_upper(s):
    return to_upper_from(s, 0)

fn to_lower_from(s, i):
    if i >= len(s):
        return ""
    return lower_char(s[i]) + to_lower_from(s, i + 1)

fn to_lower(s):
    return to_lower_from(s, 0)

fn trim_start(s):
    if len(s) == 0:
        return s
    if s[0] == " ":
        return trim_start(substring(s, 1, len(s) - 1))
    return s

fn reverse_str(s):
    if len(s) == 0:
        return s
    return reverse_str(substring(s, 1, len(s) - 1)) + s[0]

fn trim_end(s):
    return reverse_str(trim_start(reverse_str(s)))

fn trim(s):
    return trim_end(trim_start(s))

fn repeat(s, n):
    if n <= 0:
        return ""
    return s + repeat(s, n - 1)

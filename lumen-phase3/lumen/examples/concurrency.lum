fn slow_square(n):
    return n * n

let t1 = spawn slow_square(5)
let t2 = spawn slow_square(6)
print wait(t1)
print wait(t2)

fn producer(ch):
    send(ch, 1)
    send(ch, 2)
    send(ch, 3)
    return 0

let ch = chan()
let t3 = spawn producer(ch)
print receive(ch)
print receive(ch)
print receive(ch)
wait(t3)
